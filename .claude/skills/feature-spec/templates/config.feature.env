METRIC_NAME=acceptance_tests_passing
DIRECTION=higher
EVAL_CMD='TEST_PROJECT=tests/MyApp.Tests ACCEPT_FILTER=Category=Accept_myfeature bash .karpathy/eval.sh'
# Regression guard: everything EXCEPT the acceptance tests of this feature must keep passing.
GUARD_CMD='dotnet test tests/MyApp.Tests --nologo -v q --filter "Category!=Accept_myfeature"'
# Only the implementation. Never the tests. Include new-file locations and, if needed, the impl .csproj.
SCOPE='src/MyApp.Core/Features/MyFeature/* src/MyApp.Core/MyApp.Core.csproj'
MIN_DELTA=0            # integer, deterministic metric
TARGET=0               # set to TOTAL printed by the eval (all acceptance tests passing)
TIMEOUT_SEC=900
