# Feature spec harness configuration
# Sourced by loop-step.sh. Quote values that contain spaces or $.
METRIC_NAME=acceptance_test_failures
DIRECTION=lower
EVAL_CMD='dotnet test ${TEST_PROJECT} --filter "Category=Accept_${CATEGORY}" --nologo -v q 2>&1; echo "METRIC=$?"'
GUARD_CMD='dotnet test --nologo -v q'
SCOPE='DAL BLL'
MIN_DELTA=0
TIMEOUT_SEC=600
