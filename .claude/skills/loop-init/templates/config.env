# Sourced by loop-step.sh. Quote values that contain spaces or $.
METRIC_NAME=compiler_warnings
DIRECTION=lower                     # lower | higher
EVAL_CMD='bash .karpathy/eval.sh'   # must print a line: METRIC=<number>
GUARD_CMD='dotnet test --nologo -v q'   # must exit 0 for a change to count
SCOPE='src/MyApp.Core/*'            # space-separated globs of files the agent MAY edit
MIN_DELTA=0                         # set >= measured noise spread (see loop-init step 3)
TIMEOUT_SEC=600                     # per command (guard and eval each)
